---
import type { GetStaticPaths } from 'astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedArticles, type ArticleEntry } from '../../lib/articles';
import { withBase } from '../../lib/url';
import { siteConfig, type DomainConfig } from '../../site.config';

type Props = { domain: DomainConfig; articles: ArticleEntry[] };

export const getStaticPaths = (async () => {
  const articles = await getPublishedArticles();
  return siteConfig.domains.map((domain) => ({
    params: { domain: domain.key },
    props: {
      domain,
      articles: articles.filter(
        (article) => article.data.domain === domain.key,
      ),
    },
  }));
}) satisfies GetStaticPaths;

const { domain, articles } = Astro.props;
const domainTitleHighlights = {
  ai: 'Future',
  ufo: 'Anomalous',
  meta: 'Metaphysics',
  soul: 'Unseen Life',
  ling: 'Insights',
} satisfies Record<DomainConfig['key'], string>;
const highlightedDomainTitle = domainTitleHighlights[domain.key];
const [titlePrefix, titleSuffix] = domain.name.split(highlightedDomainTitle);
---

<BaseLayout
  title={domain.name}
  description={domain.description}
  canonicalPath={withBase(`${domain.key}/`)}
>
  <div class="page-shell domain-page" style={`--accent: ${domain.accent}`}>
    <Breadcrumbs items={[{ label: domain.name }]} />
    <header class="domain-hero">
      <p class="eyebrow">
        {domain.catalogLabel} · {articles.length} bài viết
      </p>
      <h1>
        {
          titleSuffix !== undefined ? (
            <>
              {titlePrefix}
              <mark class="declassified-highlight">
                {highlightedDomainTitle}
              </mark>
              {titleSuffix}
            </>
          ) : (
            domain.name
          )
        }
      </h1>
      <p>{domain.description}</p>
    </header>
    <section aria-labelledby="directory-title">
      <div class="section-heading compact">
        <div>
          <p class="eyebrow">Danh mục</p>
          <h2 id="directory-title">Tất cả bài viết</h2>
        </div>
      </div>
      <div class="article-list">
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
    </section>
  </div>
</BaseLayout>
