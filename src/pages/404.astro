---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Không tìm thấy trang" canonicalPath={withBase('404.html')}>
  <section class="page-shell not-found">
    <p class="eyebrow">Lỗi 404</p>
    <h1>Không tìm thấy trang này.</h1>
    <p>Đường dẫn có thể đã thay đổi, hoặc nội dung chưa được xuất bản.</p>
    <div class="hero-actions">
      <a class="button" href={withBase()}>Về trang chủ</a>
      <a class="text-link" href={withBase('search/')}>Mở trang tìm kiếm</a>
    </div>
  </section>
</BaseLayout>
