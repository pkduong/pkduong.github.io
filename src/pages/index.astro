---
import ArticleCard from '../components/ArticleCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedArticles } from '../lib/articles';
import { withBase } from '../lib/url';
import { siteConfig } from '../site.config';

const articles = await getPublishedArticles();
const taglineParts = siteConfig.tagline.split('Tỉnh thức');
---

<BaseLayout canonicalPath={withBase()}>
  <section class="hero page-shell">
    <div class="hero-file">
      <div class="file-meta" aria-label="Thông tin kho lưu trữ">
        <span>Kho lưu trữ: PKD // Public access</span>
        <span>Chế độ trình bày: Giải mật</span>
      </div>
      <p class="eyebrow">
        Kho dữ liệu mở · 5 lĩnh vực · {articles.length} tài liệu
      </p>
      <h1>
        {taglineParts[0]}<mark class="declassified-highlight">Tỉnh thức</mark>{
          taglineParts[1]
        }
      </h1>
      <p class="hero-lead">
        Góc nhìn đa chiều về những điều khó lý giải: từ hiện tượng dị thường
        ngoài không gian đến chiều sâu tâm thức con người.
      </p>
      <div class="redaction-row" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <div class="hero-actions">
        <a class="button" href={withBase('search/')}>Truy xuất kho tài liệu</a>
        <a class="text-link" href="#domains"
          >Mở danh mục lĩnh vực <span aria-hidden="true">↓</span></a
        >
      </div>
      <span class="declassified-stamp" aria-hidden="true">Declassified</span>
    </div>
  </section>

  <section
    class="page-shell section-block"
    id="domains"
    aria-labelledby="domains-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">Mục lục kho lưu trữ</p>
        <h2 id="domains-title">Năm lối vào kho dữ liệu giới hạn</h2>
      </div>
    </div>
    <div class="domain-grid">
      {
        siteConfig.domains.map((domain) => {
          const count = articles.filter(
            (article) => article.data.domain === domain.key,
          ).length;
          return (
            <a
              class="domain-card"
              href={withBase(`${domain.key}/`)}
              style={`--accent: ${domain.accent}`}
            >
              <span class="domain-index">{domain.catalogNumber}</span>
              <span class="domain-status">{domain.catalogLabel}</span>
              <h3 aria-label={domain.name}>
                {domain.cardTitleLines.map((line) => (
                  <span>{line}</span>
                ))}
              </h3>
              <p>{domain.description}</p>
              <span class="domain-count">{count} bài viết →</span>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="page-shell section-block" aria-labelledby="recent-title">
    <div class="section-heading compact">
      <div>
        <p class="eyebrow">Tài liệu tuyển chọn</p>
        <h2 id="recent-title">Bắt đầu truy xuất</h2>
      </div>
    </div>
    <div class="article-list">
      {articles.slice(0, 6).map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
</BaseLayout>
